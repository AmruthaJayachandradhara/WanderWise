GEMINI_API_KEY=
DUFFEL_API_KEY=
TICKETMASTER_API_KEY=
EVENTBRITE_TOKEN=
ORS_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=wanderwise
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=
QDRANT_URL=
QDRANT_API_KEY=
GROQ_API_KEY=
HF_TOKEN=

# Infra retry / circuit breaker (Phase 3 — defaults are fine for most deployments)
# LLM_RETRY_ATTEMPTS=3
# LLM_RETRY_BASE_DELAY=1.0
# LLM_CIRCUIT_FAILURE_THRESHOLD=5
# LLM_CIRCUIT_COOLDOWN_S=60.0

# Guardrail thresholds
# GUARDRAIL_TOPICALITY_THRESHOLD=0.95
# GUARDRAIL_GROUNDING_THRESHOLD=0.80
# GUARDRAIL_MAX_REFLECTION_ATTEMPTS=2

# Booking & actions (Phase 4 — defaults are fine; JSON map of booking type → provider)
# BOOKING_PROVIDER_MAP={"flight": "duffel", "hotel": "duffel", "restaurant": "mock"}
# RESERVATION_SERVICE_URL=  # empty = in-process; http://reservation:8001 in compose

# Cache TTLs (seconds)
# CACHE_TTL_VISA_DOCS=86400
# CACHE_TTL_WEATHER=3600
# CACHE_TTL_FLIGHTS=0
# CACHE_SEMANTIC_SIMILARITY_THRESHOLD=0.92

# Trace sampling (Phase 5) — fraction of runs traced to LangSmith.
# 1.0 = full (interactive/demo), 0.25 = nightly eval, 0 = off (PR-path CI).
# TRACE_SAMPLING=1.0

# LLM-as-judge (Phase 5 — defaults are fine; judge model is a tier, not a
# pinned model id, so it stays provider-agnostic)
# JUDGE_MODEL_TIER=large
# JUDGE_SAMPLE_RATE=0.5
